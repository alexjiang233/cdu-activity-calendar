notice-52e7923beba89fc569bb6947","year":2026,"published":"2026-10-15","deadline":null,"deadline_kind":"notice","stage_start":"2026-11-24","stage_end":null,"colleges":["sports"],"levels":["unknown"],"college_role":"原文相关单位，不代表报名限制","level_basis":"现有标题未明确级别，暂不推定。","audience":"各学院组织组队参赛；队员资格及组队细则见附件规程。","audience_scope":{"kind":"campus","colleges":[],"evidence":"各学院组织组队参赛；队员资格及组队细则见附件规程。"},"source_url":"https://news.cdu.edu.cn/info/1112/49714.htm","conflict":false,"edition_label":"","original_title":"","registration_windows":[],"fact_count":0,"content_profile":{"schema_version":"activity-profile-1","processed_on":"2026-10-17","status":"partial","sections":[{"kind":"other","title":"参与信息","items":[{"text":"各学院：","locator":"正文第1段","source_url":"https://news.cdu.edu.cn/info/1112/49714.htm"},{"text":"为落实《教育部等五部门关于实施学生体质强健计划的意见》，广泛开展校园群众性体育赛事，弘扬飞盘运动尊重协作的体育精神，展现成大学子朝气蓬勃、锐意进取的青春面貌，夯实学生健康根基，助力学校建设国内一流应用型城市大学。经成都大学体育运动委员会研究，决定于2026年11月24日至12月1日期间，举办成都大学第九届极限飞盘比赛。为确保本次比赛安全、顺利、圆满举行，现印发竞赛规程，请遵照执行，并认真组织开展组队参赛等相关工作。","locator":"正文第3段","source_url":"https://news.cdu.edu.cn/info/1112/49714.htm"},{"text":"附件：","locator":"正文第5段","source_url":"https://news.cdu.edu.cn/info/1112/49714.htm"},{"text":"1.成都大学第九届飞盘比赛竞赛规程.docx","locator":"正文第6段","source_url":"https://news.cdu.edu.cn/info/1112/49714.htm"},{"text":"2.成都大学第九届飞盘比赛报名表.docx","locator":"正文第7段","source_url":"https://news.cdu.edu.cn/info/1112/49714.htm"},{"text":"3.成都大学第九届飞盘比赛参赛承诺书.docx","locator":"正文第8段","source_url":"https://news.cdu.edu.cn/info/1112/49714.htm"},{"text":"成都大学体育运动委员会","locator":"正文第10段","source_url":"https://news.cdu.edu.cn/info/1112/49714.htm"}]}],"attachments":[{"title":"1.成都大学第九届飞盘比赛竞赛规程.docx","url":"https://news.cdu.edu.cn/__local/6/15/A6/D0E1B218CAB6AE62FB9690692FC_B88D1DA0_5336.docx","status":"未逐项读取"},{"title":"2.成都大学第九届飞盘比赛报名表.docx","url":"https://news.cdu.edu.cn/__local/0/93/16/3DBA1CD3E00FD2FCED74F767DFB_31A5AD06_4DA1.docx","status":"未逐项读取"},{"title":"3.成都大学第九届飞盘比赛参赛承诺书.docx","url":"https://news.cdu.edu.cn/__loc